rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════════════════════
    // FIRESTORE RULES FOR LADEVIDA WHOLESALE PLATFORM
    // ═══════════════════════════════════════════════════════════════════════════════
    //
    // WARNING: These rules are for development and are INSECURE.
    // They allow wide reads and writes to your database to keep the dev workflow fast.
    // Remove the permissive fallbacks and tighten rules before production.
    //
    // ═══════════════════════════════════════════════════════════════════════════════
    // REQUIRED FIRESTORE INDEXES (Auto-generated by migration script)
    // ═══════════════════════════════════════════════════════════════════════════════
    // 
    // INDEX 1: stores (Wholesale Discovery)
    // Fields: storeType (Asc), isWholesaleVendor (Asc)
    // Used by: getDiscoverableStores() - main wholesale discovery query
    // Status: REQUIRED - Auto-created via: npm run migrate:wholesale
    //
    // INDEX 2: stores (Optional - Direct Visibility Filtering)
    // Fields: storeType (Asc), isWholesaleVendor (Asc), wholesaleConfig.isVisible (Asc)
    // Used by: Future optimization if moving visibility filter to server-side
    // Status: OPTIONAL - Currently filtering client-side for backward compatibility
    //
    // INDEX 3: wholesaleRequests (Status Filtering)
    // Fields: toStoreId (Asc), status (Asc)
    // Used by: sendWholesaleRequest() - check existing pending requests
    // Status: AUTO-CREATED - Built-in Firestore support
    //
    // ═══════════════════════════════════════════════════════════════════════════════
    // BACKWARD COMPATIBILITY NOTES
    // ═══════════════════════════════════════════════════════════════════════════════
    //
    // The wholesale system queries for stores using storeType + isWholesaleVendor.
    // Visibility filtering (wholesaleConfig.isVisible) happens CLIENT-SIDE with defaults.
    // This allows stores created BEFORE the wholesale feature to still appear in discovery.
    //
    // Migration Script: scripts/migrate-wholesale.mjs
    // - Initializes missing wholesaleConfig on all existing stores
    // - Runs one-time with: npm run migrate:wholesale
    // - Supports: --dry-run, --skip-prompt flags
    // - Outputs clickable Firebase Console links for auto-creating indexes
    //
    // Lazy Initialization: ensureWholesaleConfig() in wholesaleActions.ts
    // - Safety net that creates config if missing (e.g., new stores)
    // - Logs warning if triggered (indicates migration wasn't run)
    //
    // ═══════════════════════════════════════════════════════════════════════════════

    // --- Helper Function for Product Validation ---
    function isValidProduct(product) {
      return (!('commission' in product) ||
                (product.commission is number &&
                 product.commission >= 1 &&
                 product.commission <= 20)) &&
             (!('originalPrice' in product) ||
                product.originalPrice == null ||
                (product.price < product.originalPrice));
    }

    // --- Helper Function for WhatsApp Schedule Validation ---
    function isValidWhatsappSchedule(schedule) {
      return schedule.storeId is string &&
             schedule.message is string &&
             schedule.scheduledTime is timestamp &&
             (schedule.status in ['scheduled', 'completed', 'missed']) &&
             (schedule.recurrence in ['none', 'daily', 'weekly']) &&
             (schedule.imageUrl == null || schedule.imageUrl is string);
    }

    // --- Helper Function for Payment Evidence TTL ---
    function isPaymentEvidenceExpired() {
      return resource.data.ttl != null && 
             request.time.toMillis() >= resource.data.ttl;
    }

    // --- Helper Function for Wholesale Config Validation ---
    function isValidWholesaleConfig(config) {
      return config is map &&
             config.isVisible is bool &&
             config.globalDiscount is number &&
             config.globalDiscount >= 0 &&
             config.globalDiscount <= 100 &&
             config.minOrderValue is number &&
             config.minOrderValue >= 0 &&
             config.defaultPaymentTermsDays in [0, 7, 14, 30];
    }

    // --- Helper Function for Wholesale Request Validation ---
    function isValidWholesaleRequest(request) {
      return request.fromStoreId is string &&
             request.toStoreId is string &&
             request.status in ['pending', 'accepted', 'rejected', 'blocked'] &&
             (request.message == null || request.message is string) &&
             request.createdAt is timestamp &&
             (request.blockedUntil == null || request.blockedUntil is timestamp) &&
             request.direction in ['incoming', 'outgoing'];
    }

    // --- Collection Group Read Rules (public reads) ---
    match /{path=**}/products/{productId} {
      allow read: if true;
    }
    match /{path=**}/categories/{categoryId} {
      allow read: if true;
    }
    match /{path=**}/referrals/{referralId} {
      allow read: if true;
    }
    match /{path=**}/whatsappSchedules/{scheduleId} {
      allow read: if true;
    }
    // Added for SuperAdmin Platform GMV Summary (Step 293 integration)
    match /{path=**}/orders/{orderId} {
      allow read: if true;
    }

    // --- Customer Data Rules ---
    match /customers/{userId} {
      allow read, write: if true;

      match /orders/{orderId} {
        allow read, create: if true;
        allow update: if (request.auth != null &&
                        exists(/databases/$(database)/documents/stores/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/customers/$(userId)/orders/$(orderId)).data.storeMeta.id == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'orderStatus', 'status', 'paymentEvidenceUrl', 'paymentStatus', 
                          'paymentEvidenceFileName', 'paymentEvidenceUploadedAt', 'ttl',
                          'disputeReason', 'deliverableUrl', 'influencerNote', 'paystackReference',
                          'paymentConfirmedAt', 'deliverableUploadedAt', 'escrowReleasedAt', 'updatedAt'
                        ]))
                     || true;
        allow delete: if true;
      }

      match /referrals/{referralId} {
        allow read, write: if true;
      }
      match /referralsByStore/{storeId} {
        allow read, write: if true;

        match /successfulOrders/{orderId} {
          allow read, write: if true;
        }
      }
    }

    // --- Store Data Rules ---
    match /stores/{storeId} {
      allow read, write: if true;

      match /orders/{orderId} {
        allow read, write: if true;
      }

      match /products/{productId} {
        allow read, create, update, delete: if true;
      }

      match /posts/{postId} {
        allow read, write: if true;
      }

      match /categories/{categoryId} {
        allow read, write: if true;
      }

      // Deprecated: Use wholesaleRequests, wholesalePartners, etc. instead
      match /wholesale/{wholesaleId} {
        allow read, write: if true;
      }

      match /contacts/{contactId} {
        allow read, write: if true;
      }

      match /referrals/{referralId} {
        allow read, write: if true;
      }

      match /whatsappSchedules/{scheduleId} {
        allow read, write: if true;
      }

      match /dailyMetrics/{metricId} {
        allow read, write: if true;
      }

      match /pitches/{pitchId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      match /slotLocks/{lockId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }

      match /bookings/{bookingId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if true;

        match /participants/{participantId} {
          allow read: if true;
          allow create: if true;
          allow update: if true;
          allow delete: if true;
        }
      }

      match /commissionPayments/{paymentId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }

      // ─────────────────────────────────────────────────────────────────────────────
      // WHOLESALE FEATURE SUBCOLLECTIONS
      // ─────────────────────────────────────────────────────────────────────────────
      // These subcollections manage wholesale partnerships, requests, and orders
      // between stores of the same type. All rules are permissive for development.
      // See migration script (scripts/migrate-wholesale.mjs) for index requirements.
      //

      match /wholesaleRequests/{requestId} {
        // Stores wholesale partnership requests sent/received
        // Fields: fromStoreId, toStoreId, status (pending|accepted|rejected|blocked),
        //         message, createdAt, respondedAt, blockedUntil, direction (incoming|outgoing)
        allow read, write: if true;
        // VALIDATION: Uncomment when in production
        // allow create: if isValidWholesaleRequest(request.resource.data);
        // allow update: if isValidWholesaleRequest(request.resource.data);
      }

      match /wholesalePartners/{partnerId} {
        // Stores active wholesale partnerships (bidirectional)
        // Fields: partnerId, partnerStoreName, status (active|paused),
        //         connectedAt, totalOrders, totalRevenue, lastOrderDate, customAgreedDiscount
        allow read, write: if true;
      }

      match /wholesaleOrders/{orderId} {
        // Stores individual wholesale orders placed by this store
        // Fields: sellerId, buyerId, items[], totalAmount, status, createdAt, etc.
        allow read, write: if true;
      }

      match /wholesaleInvoices/{invoiceId} {
        // Stores wholesale invoices (aggregated orders for settlement)
        // Fields: sellerId, buyerId, orders[], totalAmount, status, etc.
        allow read, write: if true;
      }
    }

    // --- Product Metrics Rules ---
    match /productMetrics/{metricId} {
      allow read: if true;
      allow create, update: if (request.auth != null &&
                                exists(/databases/$(database)/documents/stores/$(request.auth.uid)) &&
                                request.resource.data.storeId == request.auth.uid)
                            || true;
      allow delete: if true;
    }

    // --- Admin Config Rules ---
    match /admin/{docId} {
      allow read, write: if true;
    }

    // --- Platform & SuperAdmin Rules (NEW) ---
    match /platform/{docId} {
      allow read, write: if true; // Used for Global Broadcasts
    }

    // --- Registration Rules (NEW) ---
    match /registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // --- Wholesale Transactions (Platform-level) ---
    // Stores platform-level wholesale transactions for reporting and settlement
    match /wholesaleTransactions/{transactionId} {
      allow read, write: if true;
    }

    // --- Wholesale Invoices (Platform-level) ---
    // Stores platform-level wholesale invoices for auditing
    match /wholesaleInvoices/{invoiceId} {
      allow read, write: if true;
    }

    // --- Shared Wishlist Rules ---
    match /sharedWishlists/{wishlistId} {
      allow read, create: if true;
    }

    // --- Other Collections ---
    match /stockNotifications/{notificationId} {
      allow read, write, create, update, delete: if true;
    }
  }
}

